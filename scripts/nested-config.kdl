// nested-config.kdl - Конфигурация для отладки во вложенном Wayland-окне
// При запуске в окне (nested): Mod = Alt (не конфликтует с Super в основном Hyprland)

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 16
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

// Включаем скругление углов для окон
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Правило для терминала
window-rule {
    match app-id=r#"alacritty"#
    default-column-width { proportion 0.5; }
}

hotkey-overlay {
    skip-at-startup
}

binds {
    // В окне: Mod = Alt
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Запуск терминала и лаунчера
    Mod+Return { spawn "alacritty"; }
    Mod+T { spawn "alacritty"; }
    Mod+D { spawn "fuzzel"; }

    // Управление окнами
    Mod+Q { close-window; }
    Mod+C { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Space { toggle-window-floating; }

    // Сворачивание окон (Minimizing - фикс из spicy-main)
    Mod+M { toggle-window-minimized; }

    // Навигация по колонкам (скроллинг)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }

    // Навигация по окнам в колонке
    Mod+Down { focus-window-down; }
    Mod+Up   { focus-window-up; }
    Mod+J    { focus-window-down; }
    Mod+K    { focus-window-up; }

    // Перемещение колонок
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }

    // Воркспейсы
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // Обзор (Overview)
    Mod+Tab { toggle-overview; }
    Mod+O   { toggle-overview; }

    // Скриншоты через conchy-shot (Only Rust, Unified multi-monitor canvas)
    Print { spawn "conchy-shot"; }
    Mod+Print { spawn "conchy-shot" "screen"; }
    Mod+Shift+S { spawn "conchy-shot"; }

    // Выход из вложенного сеанса
    Mod+Shift+E { quit; }
}
